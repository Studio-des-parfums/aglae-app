server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types application/wasm application/javascript text/css application/json image/svg+xml;
    gzip_min_length 1024;

    # add_header n'est pas hérité dès qu'un bloc en redéfinit un : ces en-têtes sont
    # donc répétés dans chaque location.
    location ~* \.(wasm|png|jpe?g|webp|svg|ttf|otf|woff2?)$ {
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location / {
        add_header Cross-Origin-Opener-Policy same-origin always;
        add_header Cross-Origin-Embedder-Policy require-corp always;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
