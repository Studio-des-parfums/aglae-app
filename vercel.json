{
  "buildCommand": "bash vercel-build.sh",
  "outputDirectory": "composeApp/build/dist/wasmJs/productionExecutable",
  "installCommand": "true",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
